# DATA CLEANING AND REMOVING DUPLICATES
from IPython.display import display, Markdown
from datetime import datetime
import pandas as pd

todays_date = datetime.now().strftime("%Y-%m-%d")
student_id = "samris1626"

file_path = r'C:\Files\Excel\DA_PythonR\AirBnBSummary_v2.xlsx'
df = pd.read_excel(file_path)
df_cleaned = df.copy()

duplicate_rows_before = df[df.duplicated()]

display(Markdown(f"### {student_id} - {todays_date}"))
display(Markdown("## Duplicate Rows Before Cleaning"))
display(duplicate_rows_before)

df_cleaned.drop_duplicates(inplace=True)

duplicate_rows_after = df_cleaned[df_cleaned.duplicated()]
display(Markdown("## Duplicate Rows After Cleaning"))
display(duplicate_rows_after)


# FIX TYPOS
count_before = df['room_type'].value_counts()
typos_correction = {'Private room': 'Private Room'}
df_cleaned['room_type'].replace(typos_correction, inplace=True)

count_after = df_cleaned['room_type'].value_counts()
replaced_count = sum((count_before - count_after).fillna(0))

display(Markdown(f"### {student_id} - {todays_date}"))
display(Markdown(f"**{int(replaced_count)} entries were replaced.**"))

#Handle Missing Values
missing_values_before = df.isnull().sum()

display(Markdown(f"## {student_id} - {todays_date}"))
display(Markdown("## Missing Values Before Cleaning"))
display(missing_values_before)

for col in missing_values_before.index:
    if missing_values_before[col] > 0 and df_cleaned[col].dtype in ['float64', 'int64']:
        median_val = df_cleaned[col].median()
        df_cleaned[col].fillna(median_val, inplace=True)

missing_values_after = df_cleaned.isnull().sum()
display(Markdown("## Missing Values After Cleaning"))
display(missing_values_after)


# REMOVE OUTLIERS
outliers = {}
numerical_cols = df_cleaned.select_dtypes(include=['float64', 'int64']).columns

for col in numerical_cols:
    Q1 = df_cleaned[col].quantile(0.25)
    Q3 = df_cleaned[col].quantile(0.75)
    IQR = Q3 - Q1
    outliers[col] = df_cleaned[(df_cleaned[col] < (Q1 - 1.5 * IQR)) | (df_cleaned[col] > (Q3 + 1.5 * IQR))]

display(Markdown("**Cleaned Numerical Data Preview:**"))
display(df_cleaned[numerical_cols].head())

for col in outliers.keys():
    if not outliers[col].empty:
        median_val = df_cleaned[col].median()
        outlier_indices = outliers[col].index
        df_cleaned.loc[outlier_indices, col] = median_val

display(Markdown("**Cleaned Numerical Data Preview:**"))
display(df_cleaned[numerical_cols].head())


## EXPORT CLEANED FILE
cleaned_file_path = r'C:\Files\Excel\DA_PythonR\AirBnBSummary_v2_Python_Cleaned.xlsx'
df_cleaned.to_excel(cleaned_file_path, index=False)


## CALCULATE STATISTICS
total_listings = df_cleaned['id'].nunique()
min_price = df_cleaned['price'].min()
max_price = df_cleaned['price'].max()
mean_price = df_cleaned['price'].mean()
median_reviews = df_cleaned['number_of_reviews'].median()
mode_min_nights = df_cleaned['minimum_nights'].mode()[0]
std_price = df_cleaned['price'].std()
corr_price_avail = df_cleaned['price'].corr(df_cleaned['availability_365'])

display(Markdown(f"### {student_id} - {todays_date}"))
print(f"Total count of listings: {total_listings}")
print(f"Minimum price: {min_price}")
print(f"Maximum price: {max_price}")
print(f"Mean Price of Listings: {mean_price:.2f}")
print(f"Median of number_of_reviews: {median_reviews}")
print(f"Mode of minimum_nights: {mode_min_nights}")
print(f"Standard Deviation of price: {std_price:.2f}")
print(f"Correlation between price and availability_365: {corr_price_avail:.4f}")
